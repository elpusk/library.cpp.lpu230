interface ISoLpu230Lock : IDispatch{
	[id(1)] HRESULT OpenService([in] BSTR DeviceClass, [in] BSTR DeviceName, [in] IDispatch* pDispatch, [out,retval] LONG* pRC);
	[id(2)] HRESULT GetPropertyNumber([in] LONG PropIndex, [out,retval] LONG* pNumber);
