	[id(6)] HRESULT COFreezeEvents([in] VARIANT_BOOL Freeze, [out,retval] LONG* pRC);
	[id(7)] HRESULT CheckHealth([in] LONG Level, [out,retval] LONG* pRC);
	[id(8)] HRESULT ClaimDevice([in] LONG lTimeout, [out,retval] LONG* pRC);
	[id(9)] HRESULT Close([out,retval] LONG* pRC);
	[id(10)] HRESULT DirectIO([in] LONG Command, [in,out] LONG* pData, [in,out] BSTR* pString, [out,retval] LONG* pRC);
	[id(11)] HRESULT ReleaseDevice([out,retval] LONG* pRC);
