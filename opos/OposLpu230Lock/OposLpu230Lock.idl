	[id(13)] HRESULT RetrieveStatistics([in,out] BSTR* StatisticsBuffer, [out,retval] LONG* pRC);
	[id(14)] HRESULT UpdateStatistics([in] BSTR StatisticsBuffer, [out,retval] LONG* pRC);
	[id(15)] HRESULT WaitForKeylockChange([in] LONG nKeyPosition, [in] LONG nTimeout, [out,retval] LONG* pRC);
	[id(16)] HRESULT CompareFirmwareVersion([in] BSTR FirmwareFileName, [out] LONG* pResult, [out,retval] LONG* pRC);
	[id(17)] HRESULT UpdateFirmware([in] BSTR FirmwareFileName, [out,retval] LONG* pRC);
